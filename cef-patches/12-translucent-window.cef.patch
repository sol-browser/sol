diff --git a/libcef/browser/views/browser_view_impl.cc b/libcef/browser/views/browser_view_impl.cc
index d2713e1..f2e11dd 100644
--- a/libcef/browser/views/browser_view_impl.cc
+++ b/libcef/browser/views/browser_view_impl.cc
@@ -409,6 +409,12 @@ void CefBrowserViewImpl::SetPendingBrowserCreateParams(
 }
 
 void CefBrowserViewImpl::SetDefaults(const CefBrowserSettings& settings) {
+  // Red: see CefBrowserPlatformDelegate::Create (alpha 0, non-zero RGB).
+  if (CefColorGetA(settings.background_color) == 0 &&
+      (settings.background_color & 0xFFFFFF) != 0) {
+    SetBackgroundColor(SK_ColorTRANSPARENT);
+    return;
+  }
   SetBackgroundColor(
       CefContext::Get()->GetBackgroundColor(&settings, STATE_DISABLED));
 }
diff --git a/libcef/browser/browser_host_base.cc b/libcef/browser/browser_host_base.cc
index bd389f8..4879894 100644
--- a/libcef/browser/browser_host_base.cc
+++ b/libcef/browser/browser_host_base.cc
@@ -1721,6 +1721,13 @@ int CefBrowserHostBase::browser_id() const {
 }
 
 SkColor CefBrowserHostBase::GetBackgroundColor() const {
+  // Red: a Views-hosted browser asked for a transparent background (alpha 0,
+  // non-zero RGB, see CefBrowserPlatformDelegate::Create) keeps it as the
+  // page base background too.
+  if (is_views_hosted_ && CefColorGetA(settings_.background_color) == 0 &&
+      (settings_.background_color & 0xFFFFFF) != 0) {
+    return SK_ColorTRANSPARENT;
+  }
   // Don't use |platform_delegate_| because it's not thread-safe.
   return CefContext::Get()->GetBackgroundColor(
       &settings_, IsWindowless() ? STATE_ENABLED : STATE_DISABLED);
