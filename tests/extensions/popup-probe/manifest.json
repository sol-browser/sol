{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.0",
  "description": "Owned fixture for Sol's extension popup acceptance.",
  "permissions": [
    "tabs",
    "tabCapture"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
