{
  "manifest_version": 3,
  "name": "Sol owned native tab lifecycle probe",
  "version": "0.0.1",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
